{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "班级作业查询系统",
  "version": "2.0.0",
  "identifier": "com.homework.system",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../../frontend && npm run dev",
    "beforeBuildCommand": "cd ../../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "班级作业查询系统",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "HomeworkSystem",
    "category": "Education",
    "shortDescription": "面向高校班级的作业查询与管理系统",
    "longDescription": "班级作业查询系统支持日历视图、倒计时提醒、科目管理与角色权限控制。"
  }
}
